{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gift-finder",
  // Date alignée sur la version de workerd installée en local.
  "compatibility_date": "2026-11-10",
  "d1_databases": [
    {
      "binding": "QUOTA_DB",
      "database_name": "quota",
      // Base créée en T077 (`npx wrangler d1 create quota`).
      "database_id": "f161adc3-0925-4dc6-aba5-c4ca684aa930",
      "migrations_dir": "migrations"
    }
  ],
  // Anti-abus (research R11) : 5 requêtes par 10 s sur /api/suggestions. Compteurs tenus par
  // Cloudflare ; la clé (IP) n'est ni écrite ni journalisée par le site.
  "ratelimits": [
    {
      "name": "SUGGESTIONS_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 10 }
    }
  ],
  "vars": {
    "QUOTA_DAILY": "30",
    "QUOTA_MONTHLY": "700"
  },
  // TEMPORAIRE, prévisualisation uniquement : journaux du Worker activés pour corriger les
  // erreurs pendant les tests (7 jours de conservation au plus, principe VIII v3.0.0).
  // Repasser à false avant l'ouverture publique (T080, launch-checklist.md).
  "observability": {
    "enabled": true
  }
}
