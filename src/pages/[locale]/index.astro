---
// Page du questionnaire et des résultats, une par langue (/fr/, /en/, /es/, /de/).
import Base from "@/layouts/Base.astro";
import GiftFinder from "@/components/GiftFinder.svelte";
import { isLocale, messagesFor, t } from "@/lib/i18n";

export const prerender = false;

const { locale } = Astro.params;
if (!isLocale(locale)) {
  return new Response(null, { status: 404 });
}
---

<Base locale={locale}>
  <h1>{t(locale, "site.title")}</h1>
  <p>{t(locale, "site.tagline")}</p>
  <!-- Seuls les textes de la langue active partent au navigateur. -->
  <GiftFinder client:load locale={locale} messages={messagesFor(locale)} />
</Base>
